# Copy to .env.local and adjust. All variables are optional.

# Inference backend for both MediaPipe tasks: GPU or CPU
VITE_MEDIAPIPE_DELEGATE=GPU

# Degrees of pitch/yaw/roll beyond which a captured image's head pose counts as "tilted"
VITE_TILT_THRESHOLD_DEGREES=15

# Confidence-mask cutoff (0-1) below which a pixel is treated as background
VITE_SEGMENTATION_CONFIDENCE_THRESHOLD=0.5
